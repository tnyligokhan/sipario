# Sipario monorepo kök .gitignore
# apps/mobile ve apps/api kendi .gitignore dosyalarını taşır (Flutter/Laravel standart).

# Ruflo/claude-flow yerel durumu — makineye özgü, paylaşılmaz
.claude-flow/
.claude/settings.local.json
.claude/helpers/
.claude/checkpoints/
# Git worktree'leri asla depoya girmez (makineye özgü; hook bir kez yanlışlıkla commitlemişti)
.claude/worktrees/

# Ortam ve gizli bilgiler (kırmızı çizgi: asla commit edilmez)
.env
.env.*
# .env.example bir şablondur, sır içermez ve commitlenmesi zorunludur (Laravel konvansiyonu)
!.env.example
!**/.env.example
*.pem
*.key
*.keystore
*.jks

# Ruflo hook'larının yeniden oluşturduğu artık
.tab-navigation

# SQLite yan dosyaları (-wal / -shm). Ruflo'nun `.swarm/*.db` ve `ruvector.db` dosyaları BİLEREK
# izlenir, ama bu ikisi izlenmez: geçici yazma günlüğüdür, koşan her ajanla değişir (tek koşumda
# 1,4 MB), ve checkout ile ana .db'nin yanına ESKİ bir WAL düşerse veritabanını bozabilir.
# 2026-07-29'da bir ajan koşumu sırasında yanlışlıkla commit edildiler (d7deb94), sonra çıkarıldı.
*.db-wal
*.db-shm

# Durum çubuğunun CI önbelleği — anlık, makineye özgü.
.claude/ci-durum.json
.claude/ci-durum.kilit

# Saha sunucusu script'inin indirdiği yardımcı ikililer (cloudflared ~50 MB).
# Makineye özgüdür ve depo PUBLIC'tir — ikili dosya asla commit edilmez.
scripts/.araclar/

# İşletim sistemi / editör artıkları
Thumbs.db
Desktop.ini
.DS_Store
*.log
*.tmp
