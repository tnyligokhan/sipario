# ══════════════════════════════════════════════════════════════════════════════════════════════
#  SİPARİO API — ORTAM YAPILANDIRMASI (şablon)
# ══════════════════════════════════════════════════════════════════════════════════════════════
#
#  Kurulum:  cp .env.example .env  →  php artisan key:generate  →  php artisan migrate
#
#  BÖLÜMLER
#    1  Uygulama                     6  Coğrafi kodlama (adres → koordinat)
#    2  Günlükleme                  6b  Oto sıralama (rota motoru)
#    3  Veritabanı (ÜÇ ayrı rol)     7  Abonelik ve ödeme (iyzico)
#    4  Önbellek · kuyruk · oturum   8  Hukuk metni sürümleri
#    5  API güvenliği                9  Posta
#                                   10  Kullanılmayan altyapı (opsiyonel)
#
#  KURAL: Buradaki her satırın karşılığı `config/*.php` içinde bir `env()` çağrısıdır. Kodda
#  varsayılanı olan anahtarlar burada da GÖRÜNÜR durur — "hangi düğmeler var" sorusunun cevabı
#  tek dosyada olsun; kaynak koda inmek gerekmesin.
#
#  SIR YOK: bu dosya commit'lenir (`.gitignore` onu bilerek muaf tutar). Gerçek anahtarlar yalnız
#  `.env`e yazılır ve o dosya ASLA commit'lenmez. Aşağıdaki parolalar docker-compose'un GELİŞTİRME
#  parolalarıdır; üretimde hepsi değişir.
# ══════════════════════════════════════════════════════════════════════════════════════════════


# ── 1 · UYGULAMA ──────────────────────────────────────────────────────────────────────────────
APP_NAME=Sipario
APP_ENV=local
# `php artisan key:generate` doldurur. BOŞ bırakılırsa şifreleme ve oturum çalışmaz.
APP_KEY=
# ÜRETİMDE MUTLAKA false: true iken hata sayfaları yığın izini ve ortam değişkenlerini basar.
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

# Parola karma maliyeti. Düşürmek girişi hızlandırır ama kaba kuvveti de hızlandırır.
BCRYPT_ROUNDS=12


# ── 2 · GÜNLÜKLEME ────────────────────────────────────────────────────────────────────────────
# KVKK (kırmızı çizgi #4): loglara KİŞİSEL VERİ yazılmaz — ad, telefon, adres, koordinat.
# Üretimde LOG_LEVEL=info önerilir; debug seviyesi sorgu/gövde dökebilir.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# ── 3 · VERİTABANI (ÜÇ AYRI ROL — kırmızı çizgi #1'in temeli) ─────────────────────────────────
# Aynı veritabanı, üç farklı yetki. Ayrım kaza eseri değil, izolasyonun kendisidir:
#
#   sipario_app    → RUNTIME. superuser DEĞİL, BYPASSRLS DEĞİL → RLS uygulanır, yalnız DML.
#   sipario_owner  → MIGRATION/DEPLOY. Tabloları ve policy'leri O oluşturur.
#   sipario_panel  → YÖNETİM PANELİ (bize ait iç araç). BYPASSRLS ile cross-tenant OKUR,
#                    iş verisine YAZAMAZ (yalnız tenants/admin_users/panel_audit).
#
# Host portu 55432: docker-compose Postgres'i 55432'de yayınlar (geliştirici makinelerindeki
# yerli PostgreSQL 5432'yi tutuyor; standart port sessizce yanlış sunucuya bağlanma riski taşır).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=sipario

# Runtime rolü (config/database.php → `pgsql`)
DB_USERNAME=sipario_app
DB_PASSWORD=sipario_app_dev

# Sahip rolü (config/database.php → `pgsql_owner`)
DB_OWNER_USERNAME=sipario_owner
DB_OWNER_PASSWORD=sipario_owner_dev

# Panel rolü (config/database.php → `pgsql_panel`). Faz 5c'de küme düzeyinde ELLE kuruldu;
# CI'da `api-ci.yml` CREATE ROLE ile oluşturur. YENİ MAKİNEDE rol SQL'i elle koşulmalıdır.
# Parola BOŞ bırakılırsa panel bağlantısı kimlik doğrulayamaz ve yönetim paneli açılmaz.
DB_PANEL_USERNAME=sipario_panel
DB_PANEL_PASSWORD=sipario_panel_dev

# TLS. Yerelde `prefer` yeter; ÜRETİMDE `require` (hatta `verify-full`) olmalı — müşteri verisi
# (ad, telefon, adres, konum) bu bağlantıdan akar.
DB_SSLMODE=prefer


# ── 4 · ÖNBELLEK · KUYRUK · OTURUM ────────────────────────────────────────────────────────────
# Üçü de `database` sürücüsünde: pilot ölçeğinde Redis işletme yükü getirir, karşılığı yok.
# DİKKAT: coğrafi kodlama önbelleği ve hız sınırı sayaçları CACHE_STORE üzerinde yaşar —
# sürücü değişirse ikisi de sıfırlanır (veri kaybı değil, yalnız yeniden ısınma).
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# ÜRETİMDE true: oturum çerezi yalnız HTTPS üzerinden gitsin (yönetim paneli oturumu).
SESSION_SECURE_COOKIE=false


# ── 5 · API GÜVENLİĞİ ─────────────────────────────────────────────────────────────────────────
# CORS: virgülle ayrık origin listesi. TANIMSIZSA HİÇBİR tarayıcı origin'ine izin verilmez —
# bu GÜVENLİ VARSAYILANDIR ve mobil istemciyi etkilemez (tarayıcı değil). İleride gelecek web
# uygulaması ve abonelik sitesi buraya yazılır.
#   Örnek: CORS_ALLOWED_ORIGINS=https://sipario.com.tr,https://panel.sipario.com.tr
CORS_ALLOWED_ORIGINS=

# Sanctum token ön eki — sızan bir token'ın gizli-tarama (secret scanning) araçlarınca
# tanınmasını sağlar. Değiştirilirse ESKİ token'lar geçersizleşmez, yalnız yenileri farklı olur.
SANCTUM_TOKEN_PREFIX=sipario_
# Yalnız çerez tabanlı (SPA) istemciler için. Mobil Bearer token kullanır, bundan etkilenmez.
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1


# ── 6 · COĞRAFİ KODLAMA (adres → koordinat) ───────────────────────────────────────────────────
# "Adresten Konum Al" akışı. Anahtar YALNIZ SUNUCUDA durur — APK'ya gömülen anahtar ilk
# kurulumda çıkarılır ve kota yakılır. Sağlayıcı SOYUTTUR: aşağıdaki tek satır sürücüyü seçer,
# kodun hiçbir yeri değişmez ve mobil güncelleme GEREKMEZ.
#
#   yandex   → YANDEX_GEOCODER_KEY dolu olmalı
#   google   → GOOGLE_GEOCODER_KEY dolu olmalı
#   kademeli → önce Google; Yandex yalnız Google BİNA kesinliğinde aday veremeyince ve
#              YANDEX_DAILY_LIMIT tavanına kadar sorulur. Sonuçlar birleştirilmez — her aday
#              sağlayıcı etiketiyle ayrı satırdır, doğrusunu kullanıcı seçer. Üretimin sürücüsü.
#   null     → dış çağrı YAPILMAZ; uç nokta dürüstçe "bu kurulumda tanımlı değil" der (CI/yerel)
#
# Anahtarı olmayan sürücü otomatik `null`a DÜŞER — yanlış yapılandırma sessiz bir 500 değil,
# kullanıcıya söylenebilir bir mesaj üretir.
GEOCODING_DRIVER=null

# ── PUSH BİLDİRİMİ (FCM) ─────────────────────────────────────────────────────────────────────
#
# Firebase konsolu → Proje ayarları → Hizmet hesapları → "Yeni özel anahtar oluştur" ile inen
# JSON'un BASE64 hâli. Üretmek için:
#     base64 -w0 sipario-xxxxx.json
#
# ⚠️ BU DEĞER SIRDIR. Sızarsa üçüncü taraf bayilerimizin telefonlarına bildirim gönderebilir;
# repoya ASLA girmez. (Mobil taraftaki `google-services.json` ise sır DEĞİLDİR — APK'nın içinde
# zaten dağıtılır, anahtarı paket adına kısıtlıdır.)
#
# BOŞ BIRAKILABİLİR ve varsayılan budur: push sistemi kapalı olur, hiçbir şey kırılmaz. Dürtü
# bu üründe bir HIZLANDIRICIDIR, taşıyıcı değil — veri mevcut senkronla akmaya devam eder.
FCM_HIZMET_HESABI=

YANDEX_GEOCODER_KEY=
# Yandex'in güncel uç noktası v1'dir; ESKİ anahtarlar `https://geocode-maps.yandex.ru/1.x/` ister.
YANDEX_GEOCODER_URL=https://geocode-maps.yandex.ru/v1/
# Yandex GLOBAL günlük tavanı (kiracı başına DEĞİL — 1000/gün limiti hesabın tamamına aittir).
# Kademeli sürücü tavana ulaşınca Yandex'i o gün susturur; Google devam eder, özellik düşmez.
YANDEX_DAILY_LIMIT=900

# DİKKAT — Google anahtarı TEK BAŞINA yetmez: projede FATURALANDIRMA açık değilse anahtar
# geçerli olsa bile her istek HTTP 200 + `status=REQUEST_DENIED` ("You must enable Billing")
# döner ve sürücü bunu 503'e çevirir. Sürücüyü `google` yapmadan önce faturalandırmayı açın,
# anahtarı YALNIZ "Geocoding API" ve sunucu IP'siyle kısıtlayın (sunucu anahtarıdır, tarayıcıya
# hiç gitmez — HTTP referrer kısıtlaması YANLIŞ seçimdir, isteği reddeder).
GOOGLE_GEOCODER_KEY=
GOOGLE_GEOCODER_URL=https://maps.googleapis.com/maps/api/geocode/json

# Kiracı başına GÜNLÜK üst sınır — bozuk bir istemci döngüsü bütün bayilerin özelliğini
# kapatmasın diye zarar kendi bayisinde kalır. (Dakikalık sınır kodda sabit: 20.)
GEOCODING_DAILY_LIMIT=300
# Aynı adres iki kez sorulmaz. Önbellek GLOBAL'dir: dönen veri kamuya açık coğrafi veridir,
# kiracıya ait bilgi taşımaz — bir bayinin sorduğu mahalle diğerine bedavaya gelir.
GEOCODING_CACHE_DAYS=30
# Kullanıcıya gösterilecek en fazla aday (tasarım 3 satır çizer, 5 üst sınır).
GEOCODING_MAX_RESULTS=5
# Saniye. İstemci 20 sn bekler; sunucu ONDAN ÖNCE pes etmeli ki kullanıcı gerçek nedeni görsün.
GEOCODING_TIMEOUT=8

# Aramayı Türkiye'ye yaklaştırır ("Bahçelievler" dünyada onlarca yerde var). Kutu dışına düşen
# aday zaten elenir; bunlar yalnız ÖNCELİK ipucudur.
GEOCODING_COUNTRY=tr
GEOCODING_LANG=tr_TR
GEOCODING_BBOX=25.5,35.8~45.0,42.2


# ── 6b · OTO SIRALAMA (rota motoru) ───────────────────────────────────────────────────────────
# "Oto Sırala (rota)" kontörlü eyleminin sıralamayı hangi motorla yaptığı. Motor SOYUTTUR:
# aşağıdaki tek satır seçer, kodun hiçbir yeri değişmez, mobil güncelleme GEREKMEZ.
#
#   google       → Google Routes API (`computeRoutes` + optimizeWaypointOrder). GERÇEK yol ağını,
#                  tek yönleri ve dönüşleri bilir. GOOGLE_ROUTES_KEY dolu olmalı.
#   yakin-komsu  → kuş uçuşu en yakın komşu (varsayılan). Bedava, saf, ağı/anahtarı/kotası yok.
#
# YIKILMAZLIK — bu özellik hiçbir koşulda 5xx VERMEZ: Google arızalanırsa (anahtar, kota, ağ,
# 25'ten fazla ara durak) sunucu sessizce yakın komşuya düşer, kontör yine yalnız 1 yanar ve
# yanıttaki `engine` alanı hangi motorun ürettiğini söyler. Tanınmayan sürücü adı da yakın
# komşuya düşer — yanlış yazılmış bir env satırı özelliği KAPATMAZ.
ROTA_SURUCU=yakin-komsu

# Coğrafi kodlamadaki Google anahtarıyla AYNI proje anahtarı olabilir — ama iki ek koşulla:
# konsolda "Routes API" ETKİNLEŞTİRİLMİŞ olmalı ve anahtar kısıtlamasına "Routes API" de
# EKLENMELİ. Aksi hâlde her istek reddedilir ve sürücü kendiliğinden yakın-komşuya düşer:
# özellik ölmez, yalnız Google'dan faydalanamaz. (Sunucu anahtarıdır — IP kısıtlaması doğru
# seçimdir, HTTP referrer kısıtlaması isteği reddeder.)
GOOGLE_ROUTES_KEY=
GOOGLE_ROUTES_URL=https://routes.googleapis.com/directions/v2:computeRoutes

# Saniye. Kullanıcı sıralama BİTSİN diye beklerken bakıyor; geç kalmaktansa yakın komşuya
# düşmek daha iyidir. Satır kilidi bu çağrının DIŞINDA tutulur (uzun istek kontörü kilitlemez).
ROTA_TIMEOUT=8


# ── 7 · ABONELİK VE ÖDEME (iyzico) ────────────────────────────────────────────────────────────
# Para İMZASIZ int KURUŞ (float yok): 1200,00 TL = 120000.
SUBSCRIPTION_PRICE_KURUS=120000
SUBSCRIPTION_CURRENCY=TRY
SUBSCRIPTION_PERIOD_DAYS=365
SUBSCRIPTION_TRIAL_DAYS=30

# ⚠️ ÜRETİM ANAHTARI GİRİLİRKEN: `IyzicoPaymentGateway::verify()` MUTLAKA iyzico'ya
# sunucu-sunucu geri-sorgu + IYZWSv2 imza doğrulaması yapmalıdır. Kod fail-closed kuruldu ama
# smoke-test YETMEZ — gövdeye güvenmek "bedava abonelik" açığıdır. Sandbox'ta forged-body reddi
# ve gerçek retrieve sınanmalı.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com


# ── 8 · HUKUK METNİ SÜRÜMLERİ ─────────────────────────────────────────────────────────────────
# Kullanıcının kabul ettiği SÜRÜM + zaman `subscription_payments`a yazılır (KVKK: kart verisi
# ASLA). Metin değişince BURADAKİ SÜRÜM DE ARTMALI — yoksa eski onay yeni metni onaylamış sayılır.
LEGAL_DISTANCE_SALES_VERSION=2026-07-15
LEGAL_PREINFO_VERSION=2026-07-15
LEGAL_KVKK_VERSION=2026-07-15


# ── 9 · POSTA ─────────────────────────────────────────────────────────────────────────────────
# Yerelde `log`: e-posta gönderilmez, `storage/logs`a yazılır.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# ⚠️ GÖNDEREN ADRESİ MARKANIN PARÇASIDIR. Laravel'in varsayılanı "hello@example.com"dur ve bu
# depoda uzun süre öyle kaldı — yani gönderilen her posta var olmayan bir alan adından çıkıyordu.
# Bunun bedeli yalnız görüntü değil TESLİMATTIR: gönderen alan adı SPF/DKIM ile doğrulanamıyorsa
# posta spam'e düşer ya da hiç kabul edilmez, ve bu sessizce olur.
# Üretimde sipario.com.tr için SPF + DKIM + DMARC kaydı kurulmalı, adres o alan adında olmalı.
MAIL_FROM_ADDRESS="bilgi@sipario.com.tr"
MAIL_FROM_NAME="${APP_NAME}"


# ── 10 · KULLANILMAYAN ALTYAPI (opsiyonel) ────────────────────────────────────────────────────
# Bu projede AKTİF DEĞİL. Laravel varsayılanları yeterli; Redis/Memcached'e geçilirse açılır.
# Burada durmalarının sebebi "unutulmuş ayar" değil, "bilinçli kapalı" olduklarını göstermek.
# MEMCACHED_HOST=127.0.0.1
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"
