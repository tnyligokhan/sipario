[["entry_1785069720255_3ca00341492b3c5d",{"id":"entry_1785069720255_3ca00341492b3c5d","key":"sipario-tasarim-denetimi-kurali","namespace":"patterns","content":"SIPARIO tasarim-kod denetiminde EN SIK YAPILAN HATA: uygulamada olup tasarimda olmayan seyleri \"uygulamanin ekstrasi\" sayip gecmek. Bunlar KALDIRILMIS ozelliklerdir. Ornek: kupon. Tasarimin CSS'inde .gs-kupon/.md-kupon siniflari DURUYOR ama hicbir s-*.jsx onlari cizmiyor -> ozellik kaldirilmis, CSS artigi kalmis. Uygulamada ise kupon hala var. Denetim ucu de raporlamali: EKSIK (tasarimda var uygulamada yok), FAZLA (uygulamada var tasarimda yok = KALDIRILMIS), YANLIS (ikisinde de var ama farkli). \"CSS sinifi var ama JSX kullanmiyor\" = kaldirilmis ozellik isareti."}],["entry_1785070657019_0fbb887997512ad1",{"id":"entry_1785070657019_0fbb887997512ad1","key":"session-5cf2b292-9dbb-4aec-a374-214bdf2c7067","namespace":"cost-tracking","content":"{sessionId:5cf2b292-9dbb-4aec-a374-214bdf2c7067,cwd:C:\\\\Users\\\\GokhanT\\\\Desktop\\\\sipario,startedAt:2026-07-26T01:54:17.541Z,endedAt:2026-07-26T12:57:28.879Z,messageCount:577,byModel:{claude-opus-5:{tier:opus,input_tokens:1126,output_tokens:563749,cache_creation_input_tokens:1952387,cache_read_input_tokens:247653586,messages:577,cost_usd:450.3857002499996}},byTier:{haiku:0,sonnet:0,opus:450.3857002499996,unknown:0},total_cost_usd:450.3857002499996,capturedAt:2026-07-26T12:57:29.408Z}"}],["entry_1785231331662_91a3e03a981d5698",{"id":"entry_1785231331662_91a3e03a981d5698","key":"session-1bc547b0-b67c-4289-b657-1e817ec07fd1","namespace":"cost-tracking","content":"{sessionId:1bc547b0-b67c-4289-b657-1e817ec07fd1,cwd:C:\\\\Users\\\\GokhanT\\\\Desktop\\\\sipario,startedAt:2026-07-27T12:32:39.973Z,endedAt:2026-07-28T09:35:26.803Z,messageCount:634,byModel:{claude-opus-5:{tier:opus,input_tokens:9481,output_tokens:683325,cache_creation_input_tokens:2730784,cache_read_input_tokens:148122957,messages:549,cost_usd:324.77822549999973},<synthetic>:{tier:unknown,input_tokens:0,out